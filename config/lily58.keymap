#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        HRM_OFF {
            bindings = <&to 1>;
            key-positions = <28 31>;
            layers = <0>;
        };

        HRM_ON {
            bindings = <&to 0>;
            key-positions = <28 31>;
            layers = <1>;
        };
    };

    behaviors {
        hold_tap_mo_to: hold_tap_mo_to {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_MO_TO";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };

        hold_tap_mo_kp: hold_tap_mo_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_MO_KP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hold_tap_mo_tog: hold_tap_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_MO_TOG";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
        };
    };

    macros {
        type_uname: type_uname {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp T &kp I &kp S &kp MINUS &kp D &kp E &kp L &kp A &kp R &kp G &kp E>;
            label = "TYPE_UNAME";
        };

        surround: surround {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp A>;
            label = "SURROUND";
        };

        surround_word: surround_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp A &kp I &kp W>;
            label = "SURROUND_WORD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "HRM ON";
            bindings = <
&kp GRAVE              &kp N1          &kp N2       &kp N3          &kp N4            &kp N5                               &kp N6               &kp N7             &kp N8                      &kp N9       &kp N0                   &kp EQUAL
&hold_tap_mo_kp 1 TAB  &kp Q           &kp W        &kp E           &kp R             &kp T                                &kp Y                &kp U              &kp I                       &kp O        &kp P                    &kp MINUS
&hold_tap_mo_kp 2 ESC  &mt LEFT_GUI A  &mt LCTRL S  &mt LEFT_ALT D  &mt LEFT_SHIFT F  &hold_tap_mo_kp 3 G                  &hold_tap_mo_kp 4 H  &mt RIGHT_SHIFT J  &mt RIGHT_ALT K             &mt RCTRL L  &mt RIGHT_GUI SEMICOLON  &hold_tap_mo_kp 2 SQT
&kp LSHFT              &kp Z           &kp X        &kp C           &kp V             &kp B                &none    &none  &kp N                &kp M              &kp COMMA                   &kp DOT      &kp FSLH                 &kp RSHFT
                                                    &kp LALT        &kp LGUI          &kp SPACE            &none    &none  &kp BACKSPACE        &kp ENTER          &hold_tap_mo_kp 0 CAPSLOCK
            >;
        };

        hrm_off {
            display-name = "HRM OFF";
            bindings = <
&kp GRAVE              &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                               &kp N6               &kp N7     &kp N8                      &kp N9   &kp N0    &kp EQUAL
&kp TAB                &kp Q   &kp W   &kp E     &kp R     &kp T                                &kp Y                &kp U      &kp I                       &kp O    &kp P     &kp MINUS
&hold_tap_mo_kp 2 ESC  &kp A   &kp S   &kp D     &kp F     &hold_tap_mo_kp 3 G                  &hold_tap_mo_kp 4 H  &kp J      &kp K                       &kp L    &kp SEMI  &hold_tap_mo_kp 2 SQT
&kp LSHFT              &kp Z   &kp X   &kp C     &kp V     &kp B                &none    &none  &kp N                &kp M      &kp COMMA                   &kp DOT  &kp FSLH  &kp RSHFT
                                       &kp LALT  &kp LGUI  &kp SPACE            &none    &none  &kp BACKSPACE        &kp ENTER  &hold_tap_mo_kp 5 CAPSLOCK
            >;
        };

        symbols {
            bindings = <
&kp F1  &kp F2           &kp F3       &kp F4            &kp F5                &kp F6                         &kp F7     &kp F8                 &kp F9             &kp F10               &kp F11                &kp F12
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH          &kp DOLLAR            &kp PERCENT                    &kp CARET  &kp AMPERSAND          &kp ASTRK          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp GRAVE        &kp MINUS    &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp TILDE                      &kp PIPE   &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp EQUAL             &kp BACKSLASH          &trans
&trans  &kp TILDE        &kp UNDER    &kp LEFT_BRACE    &kp LESS_THAN         &trans       &trans    &trans  &trans     &kp GREATER_THAN       &kp RIGHT_BRACE    &kp PLUS              &kp PIPE               &trans
                                      &trans            &trans                &trans       &trans    &trans  &trans     &trans                 &trans
            >;

            label = "SYMBOL";
        };

        numpad {
            display-name = "NUMPAD";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp N7     &kp N8        &kp N9      &kp ASTERISK  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp N4     &kp N5        &kp N6      &kp SLASH     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp N1     &kp N2        &kp N3      &kp PLUS      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp EQUAL  &kp NUMBER_0  &kp PERIOD  &kp MINUS     &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans     &trans
            >;
        };

        nav {
            bindings = <
&trans          &trans         &trans      &trans     &trans         &trans                           &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp HOME       &kp K_BACK  &kp UP     &kp K_FORWARD  &kp END                          &trans  &trans  &trans  &trans  &trans  &trans
&msc SCRL_UP    &kp LG(MINUS)  &kp LEFT    &kp DOWN   &kp RIGHT      &kp LG(EQUAL)                    &trans  &trans  &trans  &trans  &trans  &trans
&msc SCRL_DOWN  &trans         &mkp RCLK   &mkp MCLK  &mkp LCLK      &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                           &trans     &trans         &trans         &trans    &trans  &trans  &trans  &trans
            >;

            label = "NAV";
        };

        control {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "CONTROL";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3      &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL
&trans      &trans        &trans                &trans                &trans            &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans            &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans      &kp K_MUTE    &kp K_VOLUME_DOWN     &kp K_VOLUME_UP       &kp K_PLAY_PAUSE  &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &type_uname
                                                &trans                &trans            &trans        &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
